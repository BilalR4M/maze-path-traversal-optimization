# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Virtual environment
venv/
ENV/
env/
.venv/

# VS Code settings
.vscode/

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
debug.log
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# mypy
.mypy_cache/
.dmypy.json

# Pyre type checker
.pyre/

# Data files
*.csv
*.tsv
*.h5
*.db
*.sqlite3

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Ignore notebook output
notebooks/*-checkpoint.ipynb
notebooks/*.nbconvert.ipynb

# Ignore docs build
/docs/_build/

# Ignore local config
*.env
.env.*

# Ignore test outputs
test-results/

# Ignore backup files
*~
*.bak
*.swp
*.tmp

# Ignore compiled files
*.pyo
*.pyd

# Ignore package-lock
package-lock.json

# Ignore Jupyter runtime
.jupyter/

# Ignore Streamlit cache
.streamlit/
